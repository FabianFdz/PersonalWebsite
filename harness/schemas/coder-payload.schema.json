{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/coder-payload.schema.json",
  "title": "Coder payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket_id", "criteria_coverage", "changes", "checks", "known_limitations"],
  "properties": {
    "ticket_id": { "type": "string", "pattern": "^TICKET-[0-9]{3}$" },
    "criteria_coverage": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion", "evidence"],
        "properties": { "criterion": { "type": "string", "minLength": 5 }, "evidence": { "type": "string", "minLength": 3 } }
      }
    },
    "changes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "command", "result"],
        "properties": { "name": { "type": "string" }, "command": { "type": "string" }, "result": { "enum": ["passed", "failed", "not_run"] } }
      }
    },
    "known_limitations": { "type": "array", "items": { "type": "string", "minLength": 3 } }
  }
}
