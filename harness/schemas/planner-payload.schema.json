{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/planner-payload.schema.json",
  "title": "Planner payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["epic_id", "tickets", "dependency_order", "risks", "approval_request"],
  "properties": {
    "epic_id": { "type": "string", "pattern": "^EPIC-[0-9]{3}$" },
    "tickets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "description", "dependencies", "acceptance_criteria", "complexity"],
        "properties": {
          "id": { "type": "string", "pattern": "^TICKET-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 10 },
          "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^TICKET-[0-9]{3}$" } },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
          "complexity": { "enum": ["small", "medium", "large"] }
        }
      }
    },
    "dependency_order": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TICKET-[0-9]{3}$" } },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "approval_request": { "$ref": "https://portfolio.local/schemas/approval.schema.json" }
  }
}
