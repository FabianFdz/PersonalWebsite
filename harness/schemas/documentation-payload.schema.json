{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/documentation-payload.schema.json",
  "title": "Documentation Specialist payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket_id", "updated_documents", "verified_commands", "coverage", "approval_request"],
  "properties": {
    "ticket_id": { "type": "string", "pattern": "^TICKET-[0-9]{3}$" },
    "updated_documents": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "verified_commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "coverage": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "approval_request": { "$ref": "https://portfolio.local/schemas/approval.schema.json" }
  }
}
