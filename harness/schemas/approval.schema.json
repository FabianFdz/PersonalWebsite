{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/approval.schema.json",
  "title": "Human approval request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "gate", "status", "question", "requested_at", "decided_at", "decided_by", "decision_note"],
  "properties": {
    "id": { "type": "string", "pattern": "^APPROVAL-[A-Z0-9-]+$" },
    "gate": { "enum": ["plan_approval", "architecture_approval", "scope_change_approval", "merge_approval"] },
    "status": { "enum": ["pending", "approved", "rejected"] },
    "question": { "type": "string", "minLength": 5 },
    "requested_at": { "type": "string", "format": "date-time" },
    "decided_at": { "type": ["string", "null"], "format": "date-time" },
    "decided_by": { "type": ["string", "null"] },
    "decision_note": { "type": ["string", "null"] }
  }
}
