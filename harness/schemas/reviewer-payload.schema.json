{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/reviewer-payload.schema.json",
  "title": "Reviewer payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket_id", "verdict", "criteria", "security_checks", "findings", "residual_risk"],
  "properties": {
    "ticket_id": { "type": "string", "pattern": "^TICKET-[0-9]{3}$" },
    "verdict": { "enum": ["approved", "changes_requested", "blocked"] },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": { "criterion": { "type": "string" }, "status": { "enum": ["met", "not_met"] }, "evidence": { "type": "string", "minLength": 3 } }
      }
    },
    "security_checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "severity", "title", "location", "evidence", "remediation", "blocking"],
        "properties": {
          "id": { "type": "string", "pattern": "^FINDING-[0-9]{3}$" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "title": { "type": "string" }, "location": { "type": "string" }, "evidence": { "type": "string" }, "remediation": { "type": "string" }, "blocking": { "type": "boolean" }
        }
      }
    },
    "residual_risk": { "enum": ["none", "low", "medium", "high"] }
  }
}
