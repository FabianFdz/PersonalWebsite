{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/epic-status.schema.json",
  "title": "Ordered epic delivery status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "epics"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "file", "status", "dependencies", "run_id", "started_at", "completed_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^EPIC-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 160 },
          "file": { "type": "string", "pattern": "^docs/epics/EPIC-[0-9]{3}-[a-z0-9-]+\\.md$" },
          "status": { "enum": ["draft", "pending", "in_progress", "completed"] },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^EPIC-[0-9]{3}$" }
          },
          "run_id": { "type": ["string", "null"], "pattern": "^RUN-[A-Z0-9-]+$" },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "completed_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
