{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/agent-output.schema.json",
  "title": "Agent output envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "run_id", "round_id", "ticket_id", "role", "status", "summary", "artifacts", "errors", "created_at", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "message_id": { "type": "string", "pattern": "^MSG-[A-Z0-9-]{8,}$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9-]+$" },
    "round_id": { "type": "string", "pattern": "^ROUND-[0-9]{3}$" },
    "ticket_id": { "type": ["string", "null"], "pattern": "^TICKET-[0-9]{3}$" },
    "role": { "enum": ["planner", "architect", "coder", "reviewer", "documentation-specialist"] },
    "status": { "enum": ["success", "blocked", "needs_human", "failed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["epic", "ticket", "adr", "code", "test", "review", "documentation", "status", "memory"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "message": { "type": "string", "minLength": 1 },
          "retryable": { "type": "boolean" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
